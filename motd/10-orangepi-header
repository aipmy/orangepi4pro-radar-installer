#!/bin/bash
echo -e "\e[1;36m"
cat << 'ASCII'
  ____            _               _____            __  __ _       
 |  _ \  __ _  __| | __ _  _ __  |_   _| __ __ _  / _|/ _(_) ___  
 | |_) |/ _` |/ _` |/ _` || '__|   | || '__/ _` || |_| |_| |/ __| 
 |  _ <| (_| | (_| | (_| || |      | || | | (_| ||  _|  _| | (__  
 |_| \_\\__,_|\__,_|\__,_||_|      |_||_|  \__,_||_| |_| |_|\___| 
                                                                  
                 RADAR TRAFFIC COUNTING SYSTEM
                         by.aipmy
ASCII
echo -e "\e[0m"

# Ambil data DEVID dinamis dari config
CONFIG_FILE="/etc/urad-config.yml"
[ -f "$CONFIG_FILE" ] || CONFIG_FILE="/home/pim/radar_v1.12/config/urad-config.yaml"
RAW_DEVID=$(grep -E '^[[:space:]]*DEVID:' "$CONFIG_FILE" 2>/dev/null | head -n 1)
RADAR_ID=$(echo "$RAW_DEVID" | cut -d'#' -f1 | cut -d':' -f2 | tr -d ' "' | tr -d '\r\n ')
[ -z "$RADAR_ID" ] && RADAR_ID="Unknown"

# Resource System Data
RAM_TOTAL=$(free -h | awk '/Mem:/ {print $2}')
RAM_USED=$(free -h | awk '/Mem:/ {print $3}')
RAM_AVAIL=$(free -h | awk '/Mem:/ {print $7}')
SWAP_TOTAL=$(free -h | awk '/Swap:/ {print $2}')
SWAP_USED=$(free -h | awk '/Swap:/ {print $3}')

DISK_TOTAL=$(df -h / | awk 'NR==2 {print $2}')
DISK_USED=$(df -h / | awk 'NR==2 {print $3}')
DISK_AVAIL=$(df -h / | awk 'NR==2 {print $4}')
DISK_PCT=$(df -h / | awk 'NR==2 {print $5}')

LOAD=$(awk '{print $1", "$2", "$3}' /proc/loadavg)
TEMP_RAW=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 45000)
TEMP=$(python3 -c "print(round($TEMP_RAW/1000, 1))")
UPTIME=$(uptime -p | sed 's/up //')
IP_ADDR=$(hostname -I | awk '{print $1}')
GATEWAY=$(ip route | awk '/default/ {print $3}' | head -n 1)

# Hardware & Arch Specs
CPU_ARCH=$(uname -m)
CPU_CORES=$(nproc)
CPU_MODEL="Cortex-A76/A55 Octa-Core"
KERNEL_VER=$(uname -r)
BIT_MODE="64-bit (aarch64) with 32-bit (armhf) compat"

# Cek Status PM2 radar
PM2_RUNNING=$(pm2 jlist 2>/dev/null | python3 -c 'import sys, json; data=json.load(sys.stdin); print(sum(1 for x in data if x.get("pm2_env", {}).get("status") == "online"))' 2>/dev/null || echo "4")
PM2_TOTAL=$(pm2 jlist 2>/dev/null | python3 -c 'import sys, json; data=json.load(sys.stdin); print(len(data))' 2>/dev/null || echo "4")

echo -e "\e[1;34m=================================================================================\e[0m"
echo -e "  \e[1;37m[ PRODUCT IDENTITY ]\e[0m"
echo -e "  • Product Name    : Radar Traffic Counting"
echo -e "  • Engineered By   : \e[1;36mby.aipmy\e[0m"
echo -e "  • RADAR ID        : \e[1;32m$RADAR_ID\e[0m"
echo -e "  • Firmware Engine : Radar Engine v1.12 (Dual Stream Pipeline MQTT + WS)"
echo -e "  • Hostname        : \e[1;33m$(hostname)\e[0m"
echo -e "\e[1;34m---------------------------------------------------------------------------------\e[0m"
echo -e "  \e[1;37m[ HARDWARE & OS ARCHITECTURE ]\e[0m"
echo -e "  • Architecture    : \e[1;32m$BIT_MODE\e[0m"
echo -e "  • Processor       : $CPU_MODEL ($CPU_CORES Cores @ up to 2.0 GHz)"
echo -e "  • Kernel Release  : Linux $KERNEL_VER"
echo -e "  • IP & Gateway    : \e[1;32m$IP_ADDR\e[0m (GW: $GATEWAY)"
echo -e "  • System Uptime   : $UPTIME"
echo -e "\e[1;34m---------------------------------------------------------------------------------\e[0m"
echo -e "  \e[1;37m[ SYSTEM RESOURCES & HEALTH ]\e[0m"
echo -e "  • RAM Memory      : Total: \e[1;32m$RAM_TOTAL\e[0m | Used: \e[1;31m$RAM_USED\e[0m | Avail: \e[1;36m$RAM_AVAIL\e[0m"
echo -e "  • Swap Memory     : Total: $SWAP_TOTAL | Used: $SWAP_USED"
echo -e "  • Storage (/)     : Total: $DISK_TOTAL | Used: $DISK_USED ($DISK_PCT) | Free: \e[1;32m$DISK_AVAIL\e[0m"
echo -e "  • CPU Temperature : \e[1;35m${TEMP}°C\e[0m"
echo -e "  • System Load     : $LOAD (1m, 5m, 15m)"
echo -e "  • PM2 Services    : \e[1;32m$PM2_RUNNING/$PM2_TOTAL Services Online\e[0m"
echo -e "\e[1;34m---------------------------------------------------------------------------------\e[0m"
echo -e "  \e[1;32m[ QUICK COMMANDS ]\e[0m"
echo -e "  • \e[1;33murad-config\e[0m     : Edit radar parameter & auto-sync hostname"
echo -e "  • \e[1;33murad-reset\e[0m      : Restart all radar services & re-sync hostname"
echo -e "  • \e[1;33mradar-debug\e[0m     : Live Doppler point-cloud inspector & calibration"
echo -e "  • \e[1;33mpm2 status\e[0m      : View real-time radar & pipeline service states"
echo -e "  • \e[1;33mpm2 logs\e[0m        : Stream live Doppler reader & upload logs"
echo -e "\e[1;34m=================================================================================\e[0m"
echo ""
